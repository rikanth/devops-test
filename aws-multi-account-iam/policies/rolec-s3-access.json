{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListNamedBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-task3-bucket"
    },
    {
      "Sid": "ReadWriteObjectsInNamedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::my-task3-bucket/*"
    }
  ]
}
